# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=enricher-news
KAFKA_INPUT_TOPIC=process.news.clean

# Database Configuration
DATABASE_URL=postgresql://Divyansh:dabadebadeba@localhost:5432/info_now_db

# OpenSearch Configuration
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=news_index

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text
OLLAMA_SUMMARY_MODEL=llama3.2
EMBEDDING_DIMENSION=768
SUMMARY_INPUT_MAX_CHARS=12000

# Processing Configuration
MAX_CHUNK_TOKENS=512
SCRAPER_WORKERS=10
SCRAPER_TIMEOUT_SECONDS=10
SCRAPER_MAX_RETRIES=2
SCRAPER_BACKOFF_SECONDS=0.75
SCRAPER_MIN_CONTENT_CHARS=100
SCRAPER_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
SCRAPER_EXTRACTOR_ORDER=trafilatura,heuristic
BATCH_SIZE=10
