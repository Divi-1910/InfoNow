OLLAMA_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Processing Configuration
MAX_CHUNK_TOKENS=512
SCRAPER_WORKERS=10
SCRAPER_TIMEOUT_SECONDS=10
BATCH_SIZE=10
